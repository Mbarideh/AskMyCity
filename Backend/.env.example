POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_postgresql_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=askmycity
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_ENRICHMENT_MODEL=gpt-5-mini

# Model used for live hosted web search in the two-pass enrichment pipeline.
OPENAI_WEB_SEARCH_MODEL=gpt-5.6

# On-demand research orchestrator
AI_RESEARCH_BATCH_SIZE=1
AI_RESEARCH_MAX_CANDIDATES=2
AI_RESEARCH_TARGET_RESULTS=1

# Hard output limits to control token spend.
AI_WEB_MAX_OUTPUT_TOKENS=1400
AI_STRUCTURE_MAX_OUTPUT_TOKENS=1200

# Background knowledge builder (cost controlled)
KNOWLEDGE_WORKER_BATCH_SIZE=1
KNOWLEDGE_DAILY_LIMIT=5


# AskMyCity v0.8 low-cost knowledge builder
OPENAI_ENRICHMENT_MODEL=gpt-5-mini
AI_RESEARCH_MAX_CANDIDATES=1
AI_STRUCTURE_MAX_OUTPUT_TOKENS=1400
AI_HTTP_TIMEOUT_SECONDS=8
AI_HTTP_MAX_BYTES=600000
AI_OFFICIAL_PAGE_LIMIT=2
AI_OFFICIAL_TEXT_LIMIT=16000

KNOWLEDGE_CITY=Ottawa
KNOWLEDGE_WORKER_BATCH_SIZE=1
KNOWLEDGE_AUTO_ENQUEUE_SIZE=3
KNOWLEDGE_DAILY_LIMIT=20
KNOWLEDGE_REFRESH_DAYS=30
KNOWLEDGE_POLL_SECONDS=15
